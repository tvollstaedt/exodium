# DOSBox binary + DLLs staged for Tauri bundling (generated by get-dosbox.sh)
src-tauri/resources/dosbox-bin/

# Win9x emulators staged for Tauri bundling (generated by get-emulators.sh)
src-tauri/resources/dosbox-x/
src-tauri/resources/86box/
src-tauri/resources/.win9x-emulators-version

# Tier 0 preview thumbnails are COMMITTED (32 MB, rarely change).
# Regenerate with: gen_thumbnails.py --preview-dir src-tauri/resources/previews/eXoDOS

